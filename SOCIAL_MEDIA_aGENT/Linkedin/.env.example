# Fill in your real OpenAI API key below. Never commit this file or share it publicly.
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional — only needed if you want the fallback chain to kick in when the
# OpenAI free tier is exhausted. Leave blank to rely on OpenAI only for v1.
GEMINI_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=

# Any string you invent yourself — used to sign Flask's session cookie.
FLASK_SECRET_KEY=qa_content_agent_secret_change_me
