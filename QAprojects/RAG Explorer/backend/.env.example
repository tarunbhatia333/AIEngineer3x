# Copy to .env and fill in. Only GROQ_API_KEY is required for local dev
# (which defaults to the local Ollama + ChromaDB stack).

# Groq — get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# --- everything below has sensible defaults; override only if needed ---

# Groq LLM ("OpenGPT 120B")
GROQ_MODEL=openai/gpt-oss-120b

# Which embeddings/vectorstore backend to use.
# Local dev defaults to ollama/chroma. On Vercel (VERCEL=1 is set automatically
# by the platform) these default to openai/pinecone instead — override here only
# to test the cloud providers locally.
# EMBEDDINGS_PROVIDER=openai
# VECTORSTORE_PROVIDER=pinecone

# Ollama (local) — the Nomic Embed model must be pulled: `ollama pull nomic-embed-text`
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# Local ChromaDB server (started by `npm run chroma`)
CHROMA_URL=http://localhost:8010
CHROMA_COLLECTION=vwo_prd

# OpenAI embeddings (used when EMBEDDINGS_PROVIDER=openai, e.g. on Vercel)
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMENSIONS=1536

# Pinecone (used when VECTORSTORE_PROVIDER=pinecone, e.g. on Vercel)
# Index is created automatically on first use if it doesn't exist yet.
PINECONE_API_KEY=
PINECONE_INDEX=rag-explorer
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Folders (relative to backend/)
DATA_DIR=../data
UPLOADS_DIR=../uploads

# Chunking
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=4

# Backend port
PORT=8787
