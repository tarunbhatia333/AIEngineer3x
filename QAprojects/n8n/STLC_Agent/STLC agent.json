    {
      "parameters": {
        "promptType": "define",
        "text": "Generate TestCases from testplan input and provide output in csv format",
        "options": {
          "systemMessage": "\"You are a QA engineer. Using the test plan,\ngenerate ONLY test_cases.csv with minimum \n40 rows covering all 13 modules.\nfile will contain all the spec file and all the test cases that you are going to create based on the test plan. Valid and invalid test cases for login and dashboard \n\nColumns: Test_Case_ID, Module, Test_Case_Title,\nPreconditions, Test_Steps, Expected_Result,\nPriority, Test_Type, Status\"\nRows: contains testcases serially\nInput:  JSON context from Agent 1\nOutput: test_cases.csv content only\n"
        }
      },
