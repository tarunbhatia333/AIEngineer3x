    {
      "parameters": {
        "promptType": "define",
        "text": "Analyze the input and based on that genrate the playright script in markdown format only",
        "options": {
          "systemMessage": "\"You are a Senior Automation Engineer.\nUsing the PRD context provided, generate\nPlaywright TypeScript test scripts for all\nHIGH priority test cases.\n\nFormat as markdown with:\n- ## section per VWO module\n- typescript code blocks\n- beforeEach() for login setup:\n  await page.goto('https://app.vwo.com/')\n- Selectors using getByRole(), getByLabel()\n- process.env.VWO_EMAIL and VWO_PASSWORD\n  for credentials\n- Comment each test with TC_ID\n\nReturn markdown only.\""
        }
      },
