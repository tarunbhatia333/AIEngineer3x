    {
      "parameters": {
        "promptType": "define",
        "text": "Analyze the attached PRD document and extract \nall required information as structured JSON.",
        "options": {
          "systemMessage": "You are a PRD analyzer. The user has uploaded a PDF \nfile of a Product Requirements Document for VWO \n(Visual Website Optimizer) at https://app.vwo.com/\n\nExtract and return ONLY a valid JSON object with \nthis exact structure. No explanation, no markdown, \nno code fences. Raw JSON only:\n\n{\n  \"product\": \"VWO - Digital Experience Optimization Platform\",\n  \"url\": \"https://app.vwo.com/\",\n  \"modules_and_features\": [\n    {\n      \"module_name\": \"A/B Testing\",\n      \"features\": [\"feature1\", \"feature2\"]\n    }\n  ],\n  \"user_flows\": [\n    \"1. User logs in → navigates to Testing → creates A/B test\",\n    \"2. User accesses Insights → generates heatmap\"\n  ],\n  \"functional_requirements\": [\n    {\"id\": \"FR1\", \"feature\": \"A/B Testing\", \"priority\": \"Must\"},\n    {\"id\": \"FR2\", \"feature\": \"SmartStats Engine\", \"priority\": \"Must\"}\n  ],\n  \"non_functional_requirements\": [\n    {\"category\": \"Performance\", \"requirement\": \"Response within 2 seconds\"},\n    {\"category\": \"Security\", \"requirement\": \"2FA, RBAC, activity logs\"}\n  ],\n  \"acceptance_criteria\": [\n    \"Users can create experiments with multiple variations\",\n    \"Results are statistically validated\"\n  ]\n}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -176,
        -64
      ],
      "id": "fd62c4ae-854d-4724-95ec-2781a3e4158c",
      "name": "PRD Fetch Agent"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "based on the input  generate the test plan Test plan ",
        "options": {
          "systemMessage": "\"You are a QA lead. Using the PRD context \nprovided, generate ONLY a test_plan.md file.\nCover all 7 sections: Overview, Objectives,\nScope, Test Types, Environment, Entry/Exit \nCriteria, Risks & Assumptions.\"\n\nInput:  JSON context from Agent 0\nOutput: test_plan.md content only\nTokens: 2048 is enough"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        176,
        -64
      ],
      "id": "212f5b61-953e-4493-ba71-5ec3ab421498",
